---
import Base from '../../layouts/Base.astro';
import EntryCard from '../../components/EntryCard.astro';
import { CATEGORIES, categoryBySlug } from '../../data/categories';
import { allEntries } from '../../lib/entries';

export async function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { category: c.slug } }));
}

const { category: slug } = Astro.params;
const category = categoryBySlug(slug!)!;
const entries = (await allEntries()).filter((e) => e.data.category === slug);
---

<Base title={category.label} description={category.blurb}>
  <div class="wrap head">
    <p class="kicker">{category.name}</p>
    <h1>{category.label}</h1>
    <p class="blurb">{category.blurb}</p>
    <p class="mono count">
      {entries.length} {entries.length === 1 ? 'ITEM' : 'ITEMS'}
    </p>
  </div>

  {
    entries.length > 0 ? (
      <div class="wrap grid">
        {entries.map((entry) => (
          <EntryCard entry={entry} />
        ))}
      </div>
    ) : (
      <p class="wrap empty">Nothing filed here yet.</p>
    )
  }
</Base>

<style>
  .head {
    padding-top: clamp(28px, 5vw, 46px);
  }
  .head .kicker {
    margin: 0 0 16px;
  }
  h1 {
    font-size: clamp(32px, 5vw, 54px);
    line-height: 1.02;
  }
  .blurb {
    margin: 18px 0 0;
    max-width: 48ch;
    font-size: 15px;
    line-height: 1.6;
    color: rgb(var(--ink-rgb) / 62%);
  }
  .count {
    margin: 18px 0 0;
    font-size: 10px;
    letter-spacing: 0.13em;
    color: rgb(var(--ink-rgb) / 45%);
  }

  .grid {
    margin-top: clamp(26px, 4vw, 44px);
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(216px, 1fr));
    gap: 20px;
  }

  .empty {
    margin-top: 34px;
    font-size: 15px;
    color: rgb(var(--ink-rgb) / 55%);
  }
</style>
