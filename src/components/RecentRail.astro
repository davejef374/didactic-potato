---
import EntryCard from './EntryCard.astro';
import { url } from '../lib/site';
import type { Entry } from '../lib/entries';

interface Props {
  entries: Entry[];
}
const { entries } = Astro.props;
---

<section class="rail-section" aria-labelledby="recent-h">
  <div class="rail-head wrap">
    <h2 id="recent-h" class="mono">RECENTLY ADDED</h2>
    <span class="mono rail-hint" aria-hidden="true">scroll →</span>
  </div>

  <div class="rail-scroller">
    <div class="rail-track">
      {entries.map((entry) => <EntryCard entry={entry} snap />)}
      <a class="rail-end" href={url('/log/')}>
        <span class="mono">THE WHOLE LOG <span aria-hidden="true">→</span></span>
      </a>
    </div>
  </div>
</section>

<style>
  .rail-section {
    padding: 26px 0 34px;
  }

  .rail-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 14px;
  }
  .rail-head h2 {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-weight: 500;
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--text-3);
  }
  .rail-hint {
    font-size: 11px;
    color: var(--text-3);
  }

  /* Line the first card up with the gutter, then let the rail run to both
     edges of the viewport. The inset has to be applied twice: once as real
     padding on the track, and once as scroll-padding on the scroller — without
     the second, `scroll-snap-type` snaps the first card's edge to the
     container's edge on load and drags the whole rail left by the inset. */
  .rail-section {
    --rail-inset: max(var(--gutter), calc((100% - var(--page)) / 2 + var(--gutter)));
  }

  .rail-scroller {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline-start: var(--rail-inset);
    /* Room for the cards to lift on hover without being clipped. */
    padding-block: 10px;
    scrollbar-width: thin;
  }

  .rail-track {
    display: flex;
    gap: 16px;
    width: max-content;
    padding-inline: var(--rail-inset);
  }

  .rail-end {
    scroll-snap-align: start;
    flex: none;
    width: 190px;
    display: grid;
    place-items: center;
    border: 1px dashed var(--rule);
    border-radius: 12px;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--text-3);
    transition: color 0.3s, border-color 0.3s;
  }
  .rail-end:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>
