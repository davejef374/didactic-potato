---
import { SITE, url } from '../lib/site';

interface Props {
  /** The nav mark links home; the footer mark is only a sign-off. */
  home?: boolean;
}
const { home = false } = Astro.props;
---

<!--
  The name and its accent dot, in one place. Both the nav and the footer set
  the mark, and the name itself comes from SITE — so a rename is one string
  in src/lib/site.ts, not a hunt through the markup.
-->
{
  home ? (
    <a class="wordmark mono" href={url('/')}>
      {SITE.name}<span class="dot">.</span>
    </a>
  ) : (
    <span class="wordmark mono">
      {SITE.name}<span class="dot">.</span>
    </span>
  )
}

<style>
  .wordmark {
    font-weight: 500;
    font-size: 13px;
    color: var(--ink);
    line-height: 1.3;
    /* Deliberately no nowrap. On the narrowest phones the nav has no room
       for a name of more than one word beside the links and the toggle; the
       mark is the only flex item there that can give, so it breaks onto two
       lines at the space and stays on one line everywhere else. */
  }
  .dot {
    color: var(--accent);
  }
  a.wordmark:hover .dot {
    color: var(--accent-hover);
  }
</style>
