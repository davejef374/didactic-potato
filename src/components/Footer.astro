---
import { SITE, url, shortDate } from '../lib/site';
import { allEntries } from '../lib/entries';

const entries = await allEntries();
const latest = entries[0];
const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="foot-inner wrap">
    <div class="col col-about">
      <span class="mark mono">{SITE.handle}.<span class="accent">index</span></span>
      <p>
        Photographs on film, drawings in ink, essays, and machines that emit light.
        Filed as they are finished.
      </p>
      <p class="mono stat">
        {entries.length} {entries.length === 1 ? 'ENTRY' : 'ENTRIES'} · KEPT SINCE 2019
        {latest && <><br />LAST ADDED {shortDate(latest.data.date)}</>}
      </p>
    </div>

    <nav class="col" aria-label="Footer">
      <h2 class="mono label">ELSEWHERE</h2>
      <a class="u-link" href={url('/log/')}>The whole log</a>
      <a class="u-link" href={url('/about/')}>About</a>
      <a class="u-link" href={url('/rss.xml')}>Feed</a>
    </nav>

    <div class="col">
      <h2 class="mono label">COLOPHON</h2>
      <p>
        Set in Instrument Serif, Instrument Sans and JetBrains Mono, served from
        this domain. Static pages, no trackers, no cookies.
      </p>
      <p class="mono stat">© {year}</p>
    </div>
  </div>
</footer>

<style>
  .foot {
    border-top: 1px solid var(--rule);
    margin-top: var(--section);
  }

  .foot-inner {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1.3fr;
    gap: var(--s6) var(--s7);
    padding-block: var(--s7) var(--s8);
  }

  .col {
    display: flex;
    flex-direction: column;
    gap: var(--s3);
    align-items: flex-start;
  }

  .mark {
    font-weight: 500;
    font-size: 13px;
    color: var(--ink);
  }
  .accent {
    color: var(--accent);
  }

  .label {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.16em;
    color: var(--text-3);
    margin: 0 0 var(--s1);
  }

  p {
    margin: 0;
    max-width: 34ch;
    font-size: 13px;
    line-height: 1.65;
    color: var(--text-3);
  }

  .stat {
    font-size: 10px;
    line-height: 1.9;
    letter-spacing: 0.12em;
    color: var(--text-3);
  }

  .col-about .stat {
    margin-top: var(--s2);
  }

  nav a {
    font-size: 13.5px;
    color: var(--text-2);
  }
  nav a:hover {
    color: var(--accent);
  }

  @media (max-width: 860px) {
    .foot-inner {
      grid-template-columns: 1fr 1fr;
    }
    .col-about {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 520px) {
    .foot-inner {
      grid-template-columns: 1fr;
    }
  }
</style>
