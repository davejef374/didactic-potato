---
import IndexList from './IndexList.astro';
import type { Strip } from '../lib/entries';

interface Props {
  index: Strip[];
}
const { index } = Astro.props;
---

<!--
  Two columns: the claim on the left, the contents on the right. The headline
  says what the site is; the index says what is actually in it. Neither needs
  the other to make sense, which is why they can stack on a phone.
-->
<section class="hero wrap">
  <div class="hero-type">
    <h1>A working archive,<br />filed as finished.</h1>

    <p class="standfirst">
      Everything I make ends up here eventually. No schedule, no theme, occasionally an essay
      about why any of it is worth doing.
    </p>
  </div>

  <IndexList index={index} />
</section>

<style>
  .hero {
    padding-top: clamp(30px, 5vw, 46px);
    display: grid;
    /* The index narrows before it disappears — at 1100px it is the designed
       300px, and between there and the stack it gives its width to the
       headline, which needs every pixel to keep "A working archive," on one
       line. */
    grid-template-columns: minmax(0, 1fr) clamp(228px, 26vw, 300px);
    gap: var(--s7);
    align-items: start;
  }

  h1 {
    font-size: clamp(38px, 6.6vw, 76px);
    line-height: 0.98;
    color: var(--ink);
  }

  /* The designed break is for the two-column layout only; once the headline
     has the full width to itself it wraps wherever it needs to. */
  h1 br {
    display: none;
  }
  @media (min-width: 860px) {
    h1 br {
      display: inline;
    }
  }

  .standfirst {
    margin: 22px 0 0;
    max-width: 460px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-3);
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s6);
    }
  }
</style>
