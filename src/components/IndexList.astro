---
import { url } from '../lib/site';
import type { Strip } from '../lib/entries';

interface Props {
  index: Strip[];
}
const { index } = Astro.props;
---

<!--
  The table of contents, set beside the headline. The strips below are the
  way to look through the archive; this is the way to read what is in it —
  all five names as words, with true counts, before anything has to be
  opened. Same data as the strips, queried once in the page.
-->
<nav class="index" aria-labelledby="index-h">
  <h2 class="index-label mono" id="index-h">INDEX</h2>

  <ul>
    {
      index.map(({ category, count }) => (
        <li>
          <a href={url(`/c/${category.slug}/`)}>
            <span class="index-name mono">{category.name}</span>
            <span class="index-count mono">{String(count).padStart(2, '0')}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .index {
    display: flex;
    flex-direction: column;
  }

  .index-label {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.16em;
    color: var(--text-3);
    margin: 0;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--rule);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* The rule belongs to the row above it, so the list closes on the last
     count rather than on a hanging line. */
  li + li a {
    border-top: 1px solid var(--rule-soft);
  }

  a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding: 11px 0;
    font-size: 10.5px;
    letter-spacing: 0.14em;
    transition: color 0.25s;
  }

  .index-name {
    font-weight: 500;
    color: var(--text-2);
    transition: color 0.25s;
  }
  .index-count {
    color: var(--text-3);
    transition: color 0.25s;
  }

  a:hover .index-name,
  a:hover .index-count,
  a:focus-visible .index-name,
  a:focus-visible .index-count {
    color: var(--accent);
  }

  /* Once the hero stacks, the strips below stack too — and a stacked strip
     is a row with the same category name and the same count, half a screen
     lower. Two identical lists in a column is not a table of contents, it is
     a repeat, so the index stands down on phones and lets the strips be the
     index. Nothing is lost: the rows below say the same thing and open. */
  @media (max-width: 860px) {
    .index {
      display: none;
    }
  }
</style>
