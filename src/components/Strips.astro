---
import Frame from './Frame.astro';
import { url, shortDate } from '../lib/site';
import type { Strip } from '../lib/entries';

interface Props {
  strips: Strip[];
}
const { strips } = Astro.props;
---

<!--
  A CSS-only accordion. Five radios in one group, `:has(:checked)` doing the
  opening — no JavaScript, so it works on the first paint and keeps arrow-key
  navigation for free.
-->
<section id="collections" class="strips-section" aria-labelledby="collections-h">
  <h2 id="collections-h" class="visually-hidden">Collections</h2>

  <div class="strips wrap">
    {
      strips.map(({ category, count, featured }, i) => (
        <div class="strip">
          <input
            class="visually-hidden"
            type="radio"
            name="strip"
            id={`strip-${category.slug}`}
            checked={i === 0}
          />

          <label class="rail" for={`strip-${category.slug}`}>
            <span class="rail-name mono">{category.name}</span>
            <span class="rail-count mono">{String(count).padStart(2, '0')}</span>
          </label>

          <div class="strip-body">
            <div class="strip-body-inner">
              <div class="strip-lede">
                <div class="strip-head">
                  <span class="strip-kicker mono">
                    {featured?.data.kicker ?? 'NOTHING FILED YET'}
                  </span>
                  <span class="strip-count mono">
                    {count} {count === 1 ? 'ITEM' : 'ITEMS'}
                  </span>
                </div>

                <h3 class="strip-title">
                  {featured ? (
                    <a href={url(`/log/${featured.id}/`)}>{featured.data.title}</a>
                  ) : (
                    category.label
                  )}
                </h3>

                <p class="strip-blurb">{featured?.data.blurb ?? category.blurb}</p>

                <div class="strip-foot">
                  <span class="strip-last mono">
                    {featured ? `LAST ADDED ${shortDate(featured.data.date)}` : 'EMPTY SHELF'}
                  </span>
                  <a class="strip-all mono" href={url(`/c/${category.slug}/`)}>
                    ALL {category.name}
                    <span class="arrow" aria-hidden="true">
                      →
                    </span>
                  </a>
                </div>
              </div>

              {featured && (
                <a class="strip-feature" href={url(`/log/${featured.id}/`)} tabindex="-1" aria-hidden="true">
                  <Frame
                    image={featured.data.image}
                    alt={featured.data.imageAlt ?? ''}
                    slot={featured.data.slot}
                    category={category.slug}
                    tone="ground"
                    widths={[380, 660, 990]}
                    sizes="(max-width: 860px) 92vw, 330px"
                  />
                </a>
              )}
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .strips-section {
    margin-top: var(--s6);
  }

  .strips {
    display: flex;
    height: clamp(286px, 31vw, 326px);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .strip {
    position: relative;
    flex: 0 0 78px;
    overflow: hidden;
    background: transparent;
    transition: flex 0.5s var(--ease), background-color 0.4s var(--ease);
  }
  .strip + .strip {
    border-left: 1px solid var(--rule);
  }

  /* Open. In light mode this sinks into the paper; in dark mode the same
     gesture has to go the other way — there is nothing darker than the page
     to sink into — so it rises on an edge and a shadow instead. */
  .strip:has(input:checked) {
    flex: 1 1 0;
    background: var(--open-bg);
    box-shadow: var(--open-shadow);
    border-inline: 1px solid var(--open-edge);
  }

  .rail {
    position: absolute;
    inset: 0 auto 0 0;
    width: 78px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: 20px 0;
    cursor: pointer;
  }
  .strip:has(input:checked) .rail {
    display: none;
  }

  .rail-name {
    writing-mode: vertical-rl;
    font-weight: 500;
    font-size: 11.5px;
    letter-spacing: 0.18em;
    color: var(--text-2);
    transition: color 0.25s;
  }
  .rail-count {
    font-size: 10px;
    color: var(--text-3);
  }
  .rail:hover .rail-name {
    color: var(--accent);
  }

  /* The radio is visually hidden, so its focus ring has to be borrowed. */
  .strip:has(input:focus-visible) .rail {
    outline: 2px solid var(--accent);
    outline-offset: -4px;
    border-radius: 4px;
  }

  .strip-body {
    padding: var(--s5);
    min-width: 430px;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s 0.14s, visibility 0.3s;
  }
  .strip:has(input:checked) .strip-body {
    opacity: 1;
    visibility: visible;
  }

  /* Two columns: the writing on the left, the work on the right. Without the
     second column the open panel is more than half empty at desktop widths. */
  .strip-body-inner {
    height: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(190px, 27vw, 330px);
    gap: var(--s6);
  }

  .strip-lede {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .strip-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s4);
  }
  .strip-kicker {
    font-weight: 500;
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--open-accent);
  }
  .strip-count {
    font-size: 10px;
    color: var(--on-text-3);
  }

  .strip-title {
    margin-top: var(--s3);
    font-size: clamp(28px, 3.1vw, 40px);
    line-height: 1.02;
    color: var(--open-ink);
    max-width: 13ch;
  }
  .strip-title a {
    transition: color 0.25s;
  }
  .strip-title a:hover {
    color: var(--open-accent);
  }

  .strip-blurb {
    margin: var(--s3) 0 0;
    max-width: 40ch;
    font-size: 14px;
    line-height: 1.62;
    color: var(--on-text-2);
  }

  .strip-foot {
    margin-top: auto;
    padding-top: var(--s4);
    border-top: 1px solid rgb(var(--open-ink-rgb) / 12%);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s4);
    flex-wrap: wrap;
  }

  .strip-last {
    font-size: 10px;
    letter-spacing: 0.13em;
    color: var(--on-text-3);
  }

  .strip-all {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--on-text-3);
    transition: color 0.3s;
  }
  .strip-all .arrow {
    transition: transform 0.3s var(--ease);
  }
  .strip-all:hover {
    color: var(--open-accent);
  }
  .strip-all:hover .arrow {
    transform: translateX(4px);
  }

  /* A print mounted on dark board: an edge, a shadow that seats it, and
     enough room that a landscape frame is shown whole instead of cropped
     to a portrait slot. */
  .strip-feature {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
  }
  .strip-feature :global(.frame) {
    width: 100%;
    max-height: 100%;
    border-radius: 8px;
    border: 1px solid rgb(var(--open-ink-rgb) / 14%);
    box-shadow: 0 10px 28px rgb(0 0 0 / 34%);
  }

  /* ── Phones: the same five strips, stacked ─────────────────────────────── */
  @media (max-width: 860px) {
    .strips {
      display: block;
      height: auto;
    }
    .strip {
      flex: none;
    }
    .strip + .strip {
      border-left: none;
      border-top: 1px solid var(--rule);
    }
    .strip:has(input:checked) {
      border-inline: none;
    }

    .rail {
      position: static;
      width: auto;
      flex-direction: row;
      align-items: center;
      padding: 15px 2px;
    }
    .rail-name {
      writing-mode: horizontal-tb;
    }
    /* Open on a phone keeps its rail — it is the only heading you can see. */
    .strip:has(input:checked) .rail {
      display: flex;
    }
    .strip:has(input:checked) .rail-name {
      color: var(--open-ink);
    }
    .strip:has(input:checked) .rail-count {
      color: var(--on-text-3);
    }

    /* The 0fr -> 1fr expand. The breathing room below has to live on the
       GRID CONTAINER, not the item: an fr track is floored by its item's
       outer size, so padding on the item would keep every closed strip
       22px tall instead of collapsing it to nothing. */
    .strip-body {
      min-width: 0;
      height: auto;
      padding: 0 2px;
      overflow: hidden;
      display: grid;
      grid-template-rows: 0fr;
      transition: grid-template-rows 0.4s var(--ease), padding-bottom 0.4s var(--ease),
        opacity 0.3s 0.14s, visibility 0.3s;
    }
    .strip:has(input:checked) .strip-body {
      grid-template-rows: 1fr;
      padding-bottom: var(--s5);
    }
    .strip-body-inner {
      min-height: 0;
      height: auto;
      overflow: hidden;
      display: flex;
      flex-direction: column-reverse;
      gap: var(--s4);
    }

    /* Image first on a phone, and wider than tall so it does not eat the
       screen before the words arrive. */
    .strip-feature {
      display: block;
    }
    .strip-feature :global(.frame) {
      aspect-ratio: 16 / 10;
      height: auto;
    }

    .strip-title {
      max-width: none;
    }
    .strip-foot {
      margin-top: var(--s4);
    }
  }
</style>
